# Application
PORT=5000
NODE_ENV=development

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=vitalsync_db
DATABASE_URL=postgresql://postgres:replace_with_secure_password@postgres:5432/vitalsync_db?schema=public

# Authentication
JWT_SECRET=replace_with_secure_jwt_secret
JWT_EXPIRES_IN=7d
